# Copy this file to .env for local development. Values below are local examples only.
POSTGRES_USER=waffarly_dev
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_DB=waffarly
POSTGRES_PORT=5433
DATABASE_URL=postgresql://waffarly_dev:local_dev_password_change_me@localhost:5433/waffarly?schema=public

API_PORT=4000
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STARTUP_ATTEMPTS=5
DATABASE_STARTUP_RETRY_DELAY_MS=1000
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000
VITE_STOREFRONT_BASE_URL=http://localhost:3000
# Production only: set the same bare domain in API and storefront environments.
# STOREFRONT_BASE_DOMAIN=example.com
VITE_SUPPORT_WHATSAPP=201044280822

# Generate a hash with: pnpm --filter @waffarly/api admin:hash-password
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD_HASH=
