{
  "name": "@waffarly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "admin:hash-password": "tsx src/scripts/hash-password.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/health.e2e.test.ts test/plans.e2e.test.ts test/activities-modules.e2e.test.ts test/merchant-applications.e2e.test.ts test/multi-business.e2e.test.ts",
    "test:activities-db": "tsx --test test/activities-modules.database.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@waffarly/contracts": "workspace:*",
    "@waffarly/database": "workspace:*",
    "dotenv": "17.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "@waffarly/typescript-config": "workspace:*",
    "supertest": "7.2.2",
    "typescript": "5.9.3"
  }
}
