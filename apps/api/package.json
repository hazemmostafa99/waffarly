{
  "name": "@waffarly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=waffarly-source --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "admin:hash-password": "tsx src/scripts/hash-password.ts",
    "catalog:seed": "tsx src/scripts/seed-catalog.ts",
    "pos:seed-live-e2e": "tsx src/scripts/seed-pos-live-e2e.ts",
    "inventory:seed-demo": "tsx src/scripts/seed-arabic-inventory-demo.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/http/*.test.ts test/unit/*.test.ts",
    "test:customers-db": "tsx test/support/database-runner.ts customers",
    "test:customer-auth-db": "tsx test/support/database-runner.ts customer-auth",
    "test:catalog-db": "tsx test/support/database-runner.ts catalog",
    "test:inventory-db": "tsx test/support/database-runner.ts inventory",
    "test:purchasing-db": "tsx test/support/database-runner.ts purchasing",
    "test:storefront-orders-db": "tsx test/support/database-runner.ts orders",
    "test:pos-db": "tsx test/support/database-runner.ts pos",
    "test:pos-number-db": "tsx test/support/database-runner.ts pos-number",
    "test:shifts-db": "tsx test/support/database-runner.ts shifts",
    "test:cash-db": "tsx test/support/database-runner.ts cash",
    "test:employees-db": "tsx test/support/database-runner.ts employees",
    "test:pos-appearance-db": "tsx test/support/database-runner.ts pos-appearance",
    "test:pos-returns-db": "tsx test/support/database-runner.ts pos-returns",
    "test:activities-db": "tsx test/support/database-runner.ts activities",
    "check": "tsx test/support/check-api.ts",
    "test:db": "tsx test/support/database-runner.ts",
    "test:db:prepare": "tsx test/support/database-runner.ts --prepare",
    "test:subscriptions-db": "tsx test/support/database-runner.ts subscriptions"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@waffarly/contracts": "workspace:*",
    "@waffarly/database": "workspace:*",
    "dotenv": "17.2.3",
    "morgan": "1.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.3",
    "@types/morgan": "1.9.10",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "@waffarly/typescript-config": "workspace:*",
    "supertest": "7.2.2",
    "typescript": "5.9.3"
  }
}
