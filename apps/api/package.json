{
  "name": "@waffarly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "admin:hash-password": "tsx src/scripts/hash-password.ts",
    "catalog:seed": "tsx src/scripts/seed-catalog.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/http/*.test.ts test/unit/*.test.ts",
    "test:catalog-db": "tsx --test test/database/catalog.database.test.ts test/database/catalog-seed.database.test.ts test/database/pagination.database.test.ts test/database/product-inventory.database.test.ts",
    "test:inventory-db": "tsx --test test/database/inventory.database.test.ts test/database/inventory-ledger.database.test.ts",
    "test:purchasing-db": "tsx --test test/database/purchasing.database.test.ts",
    "test:storefront-orders-db": "tsx --test test/database/storefront-orders.database.test.ts",
    "test:activities-db": "tsx --test test/database/activities-modules.database.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@waffarly/contracts": "workspace:*",
    "@waffarly/database": "workspace:*",
    "dotenv": "17.2.3",
    "morgan": "1.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.3",
    "@types/morgan": "1.9.10",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "@waffarly/typescript-config": "workspace:*",
    "supertest": "7.2.2",
    "typescript": "5.9.3"
  }
}
