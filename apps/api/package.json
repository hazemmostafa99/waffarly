{
  "name": "@waffarly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=waffarly-source --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "admin:hash-password": "tsx src/scripts/hash-password.ts",
    "catalog:seed": "tsx src/scripts/seed-catalog.ts",
    "pos:seed-live-e2e": "tsx src/scripts/seed-pos-live-e2e.ts",
    "inventory:seed-demo": "tsx src/scripts/seed-arabic-inventory-demo.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/http/*.test.ts test/unit/*.test.ts",
    "test:customers-db": "tsx --test test/database/customers.database.test.ts",
    "test:customer-auth-db": "tsx --test test/database/customer-auth.database.test.ts",
    "test:catalog-db": "tsx --test test/database/catalog.database.test.ts test/database/catalog-seed.database.test.ts test/database/pagination.database.test.ts test/database/product-inventory.database.test.ts test/database/modifier-effects.database.test.ts",
    "test:inventory-db": "tsx --test test/database/inventory.database.test.ts test/database/inventory-ledger.database.test.ts test/database/inventory-visibility.database.test.ts",
    "test:purchasing-db": "tsx --test test/database/purchasing.database.test.ts",
    "test:storefront-orders-db": "tsx --test test/database/storefront-orders.database.test.ts test/database/recipe-order-lifecycle.database.test.ts",
    "test:pos-db": "tsx --test --test-isolation=none test/database/pos-dining.database.test.ts test/database/pos-operations-report.database.test.ts",
    "test:pos-number-db": "tsx --test --test-isolation=none test/database/pos-order-numbers.database.test.ts",
    "test:shifts-db": "tsx --test --test-isolation=none test/database/shift-reconciliation.database.test.ts test/database/shifts.database.test.ts test/database/pos-delivery.database.test.ts test/database/cash-custody.database.test.ts",
    "test:cash-db": "tsx --test --test-isolation=none test/database/cash-custody.database.test.ts",
    "test:employees-db": "tsx --test --test-isolation=none test/database/employee-roles.database.test.ts",
    "test:pos-appearance-db": "tsx --test --test-isolation=none test/database/merchant-pos-appearance.database.test.ts",
    "test:pos-returns-db": "tsx --test --test-isolation=none test/database/pos-returns.database.test.ts test/database/pos-returns-report.database.test.ts",
    "test:activities-db": "tsx --test test/database/activities-modules.database.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@waffarly/contracts": "workspace:*",
    "@waffarly/database": "workspace:*",
    "dotenv": "17.2.3",
    "morgan": "1.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.3",
    "@types/morgan": "1.9.10",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "@waffarly/typescript-config": "workspace:*",
    "supertest": "7.2.2",
    "typescript": "5.9.3"
  }
}
