{
  "name": "waffarly",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "dev": "pnpm exec turbo run build --filter=@waffarly/contracts --filter=@waffarly/database --filter=@waffarly/ui && pnpm --recursive --parallel --filter @waffarly/api --filter @waffarly/storefront --filter @waffarly/super-admin --filter @waffarly/merchant-dashboard --filter @waffarly/pos dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @waffarly/database db:generate",
    "db:validate": "pnpm --filter @waffarly/database db:validate",
    "db:migrate": "pnpm --filter @waffarly/database db:migrate",
    "db:check": "pnpm --filter @waffarly/database db:check"
  },
  "devDependencies": {
    "@waffarly/eslint-config": "workspace:*",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
