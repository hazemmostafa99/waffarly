  originalPaymentShiftId String               @db.Uuid
  position               Int
  method                 String               @db.VarChar(12)
  amount                 Decimal              @db.Decimal(12, 2)
  terminalReference      String?              @db.VarChar(80)
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  merchant               Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  refund                 PosOrderRefund       @relation(fields: [refundId, shiftId, merchantId], references: [id, shiftId, merchantId], onDelete: Restrict)
  originalPayment        PosOrderPayment      @relation(fields: [originalPaymentId, originalPaymentShiftId, merchantId], references: [id, shiftId, merchantId], onDelete: Restrict)
  cashMovement           PosShiftRefundMovement?

  @@unique([id, shiftId, merchantId])
  @@unique([refundId, position])
  @@index([merchantId, originalPaymentId, originalPaymentShiftId])
