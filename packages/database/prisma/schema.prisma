}

// Immutable cash count and payment-channel reconciliation recorded at shift close.
model PosShiftCloseReport {
  deliveryCashReceived Decimal      @default(0) @db.Decimal(12, 2)
  deliveryHandover      Json?
  id                   String       @id @default(uuid()) @db.Uuid
  merchantId           String       @db.Uuid
  shiftId              String       @db.Uuid
  requestId            String       @db.Uuid
  fingerprint          String       @db.VarChar(64)
  operatorEmployeeId   String       @db.Uuid
  approvedByEmployeeId String?      @db.Uuid
  currency             String       @default("EGP") @db.Char(3)
  openingFloat         Decimal      @db.Decimal(12, 2)
  cashSales            Decimal      @db.Decimal(12, 2)
  cashRefunds          Decimal      @db.Decimal(12, 2)
  cashIn               Decimal      @db.Decimal(12, 2)
  cashOut              Decimal      @db.Decimal(12, 2)
  cashDrop             Decimal      @default(0) @db.Decimal(12, 2)
  expectedCash         Decimal      @db.Decimal(12, 2)
  countedCash          Decimal      @db.Decimal(12, 2)
  variance             Decimal      @db.Decimal(12, 2)
  terminalSales        Decimal      @db.Decimal(12, 2)
  terminalRefunds      Decimal      @db.Decimal(12, 2)
  reason               String?      @db.VarChar(500)
  snapshot             Json
  closedAt             DateTime     @db.Timestamptz(6)
  merchant             Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  shift                PosShift     @relation(fields: [shiftId, merchantId], references: [id, merchantId], onDelete: Restrict)
  operator             PosEmployee  @relation("PosShiftCloseOperator", fields: [operatorEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  approvedBy           PosEmployee? @relation("PosShiftCloseApprover", fields: [approvedByEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([shiftId, merchantId])
  @@unique([merchantId, requestId])
  @@index([merchantId, closedAt, shiftId])
  @@map("pos_shift_close_reports")
}

// Courier-held customer cash is a payment, but only remittance enters a drawer.
model PosDelivery {
