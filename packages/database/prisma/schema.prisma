generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// Infrastructure-only marker keeps the Prisma generator and migration toolchain verifiable.
// It has no business meaning and contains no merchant or customer data.
model FoundationMarker {
  id Int @id @default(dbgenerated("nextval('_waffarly_foundation_marker_id_seq'::regclass)"))

  @@map("_waffarly_foundation_marker")
}

// A merchant is the tenant boundary across business activities.
model Merchant {
  id                    String               @id @default(uuid()) @db.Uuid
  name                  String               @db.VarChar(160)
  activity String @default("other") @db.VarChar(32)
  contactPhone          String               @db.VarChar(32)
  ownerName             String               @db.VarChar(160)
  ownerMobile           String               @db.VarChar(32)
  firstMonthActivatedAt DateTime?            @db.Timestamptz(6)
  firstMonthActivatedBy String?              @db.VarChar(80)
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  owner                 OwnerAccount?
  application           MerchantApplication?
  storefront            MerchantStorefront?
  mediaAssets           MediaAsset[]
  categories            Category[]
  products              Product[]

  @@map("merchants")
}

// Public merchant applications remain separate from merchant tenants until approval.
model MerchantApplication {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(160)
  activity String @default("other") @db.VarChar(32)
  contactPhone String    @db.VarChar(32)
  ownerName    String    @db.VarChar(160)
  ownerMobile  String    @db.VarChar(32)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  approvedAt   DateTime? @db.Timestamptz(6)
  approvedBy   String?   @db.VarChar(80)
  rejectedAt   DateTime? @db.Timestamptz(6)
  rejectedBy   String?   @db.VarChar(80)
  rejectionReason String? @db.Text
  merchantId   String?   @unique @db.Uuid
  merchant     Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("merchant_applications")
}

model OwnerAccount {
  id           String   @id @default(uuid()) @db.Uuid
  merchantId   String   @unique @db.Uuid
  username     String   @unique @db.VarChar(80)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@map("owner_accounts")
}

// Opaque tokens are stored only as hashes. Admin identity is configured outside the database.
model AuthSession {
  tokenHash   String   @id @db.VarChar(64)
  subjectKind String   @db.VarChar(10)
  subjectId   String   @db.VarChar(80)
  expiresAt   DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([subjectKind, subjectId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// Platform-owned presentation definitions. Tenant choices are persisted separately; publication is distinct.
model StorefrontTemplate {
  id          String               @id @default(uuid()) @db.Uuid
  key         String               @unique @db.VarChar(80)
  name        String               @db.VarChar(160)
  description String               @db.VarChar(1000)
  activity    String               @db.VarChar(32)
  layout      String               @db.VarChar(32)
  accentColor String               @db.VarChar(7)
  status      String               @default("draft") @db.VarChar(16)
  revision    Int                  @default(1)
  updatedBy   String               @db.VarChar(80)
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(6)
  merchants   MerchantStorefront[]

  @@index([activity, status])
  @@map("storefront_templates")
}

// Merchant-specific choices are separate from the shared presentation definition.
model MerchantStorefront {
  merchantId  String             @id @db.Uuid
  templateId  String             @db.Uuid
  accentColor String             @db.VarChar(7)
  logoData    String?            @db.Text
  revision    Int                @default(1)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  merchant    Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  template    StorefrontTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@map("merchant_storefronts")
}

// Commercial definitions only. Merchant coverage and collection are separate concerns.
model MonthlyPlan {
  id              String   @id @default(uuid()) @db.Uuid
  creationRequest String   @unique @db.Uuid
  name            String   @db.VarChar(160)
  description     String   @db.VarChar(1000)
  monthlyPrice    Decimal  @db.Decimal(10, 2)
  currency        String   @db.VarChar(3)
  billingInterval String   @default("monthly") @db.VarChar(16)
  revision        Int      @default(1)
  createdBy       String   @db.VarChar(80)
  updatedBy       String   @db.VarChar(80)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@map("monthly_plans")
}

// Dashboard overrides of code-managed definitions. Applicability is catalog metadata only.
model BusinessActivity {
  key         String   @id @db.VarChar(80)
  name        String   @db.VarChar(160)
  description String   @db.VarChar(1000)
  moduleKeys  String[] @default([])
  revision    Int      @default(1)
  updatedBy   String   @db.VarChar(80)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("business_activities")
}

model PlatformModule {
  key         String   @id @db.VarChar(80)
  name        String   @db.VarChar(160)
  description String   @db.VarChar(1000)
  revision    Int      @default(1)
  updatedBy   String   @db.VarChar(80)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("platform_modules")
}

// Reusable tenant-owned media metadata. Binary storage is an infrastructure concern.
model MediaAsset {
  id           String           @id @default(uuid()) @db.Uuid
  merchantId   String           @db.Uuid
  storageKey   String           @db.VarChar(255)
  publicUrl    String           @db.Text
  mimeType     String           @db.VarChar(80)
  sizeBytes    Int
  createdBy    String           @db.VarChar(80)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  merchant     Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  categories   Category[]
  productImages ProductImage[]

  @@unique([merchantId, storageKey])
  @@unique([id, merchantId])
  @@index([merchantId, createdAt])
  @@map("media_assets")
}

model Category {
  id              String            @id @default(uuid()) @db.Uuid
  merchantId      String            @db.Uuid
  name            String            @db.VarChar(160)
  description     String?           @db.VarChar(1000)
  imageAssetId    String            @db.Uuid
  parentId        String?           @db.Uuid
  availability    String            @db.VarChar(16)
  archivedAt      DateTime?         @db.Timestamptz(6)
  revision        Int               @default(1)
  createdBy       String            @db.VarChar(80)
  updatedBy       String            @db.VarChar(80)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  merchant        Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  imageAsset      MediaAsset        @relation(fields: [imageAssetId, merchantId], references: [id, merchantId], onDelete: Restrict)
  parent          Category?         @relation("CategoryHierarchy", fields: [parentId, merchantId], references: [id, merchantId], onDelete: Restrict)
  children        Category[]        @relation("CategoryHierarchy")
  productLinks    ProductCategory[]

  @@index([merchantId, availability, archivedAt])
  @@index([merchantId, parentId])
  @@unique([id, merchantId])
  @@map("categories")
}

model Product {
  id              String            @id @default(uuid()) @db.Uuid
  merchantId      String            @db.Uuid
  name            String            @db.VarChar(160)
  description     String?           @db.VarChar(1000)
  basePrice       Decimal           @db.Decimal(12, 2)
  availability    String            @db.VarChar(16)
  archivedAt      DateTime?         @db.Timestamptz(6)
  revision        Int               @default(1)
  createdBy       String            @db.VarChar(80)
  updatedBy       String            @db.VarChar(80)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  merchant        Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  images          ProductImage[]
  categoryLinks   ProductCategory[]

  @@index([merchantId, availability, archivedAt])
  @@unique([id, merchantId])
  @@map("products")
}

model ProductImage {
  id           String     @id @default(uuid()) @db.Uuid
  productId    String     @db.Uuid
  mediaAssetId String     @db.Uuid
  merchantId   String     @db.Uuid
  isPrimary    Boolean    @default(false)
  position     Int        @default(0)
  product      Product    @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Restrict)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([productId, mediaAssetId])
  @@index([merchantId, productId])
  @@index([productId, position])
  @@map("product_images")
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  merchantId String   @db.Uuid
  product    Product  @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Restrict)
  category   Category @relation(fields: [categoryId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([merchantId, productId])
  @@index([categoryId, productId])
  @@map("product_categories")
}
