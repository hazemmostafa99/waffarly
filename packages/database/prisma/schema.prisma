  amount               Decimal                @db.Decimal(12, 2)
  currency             String                 @default("EGP") @db.Char(3)
  issuedAt             DateTime               @db.Timestamptz(6)
  snapshot             Json
  merchant             Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  order                StorefrontOrder        @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  createdBy            PosEmployee            @relation("PosItemReturnIssuer", fields: [createdByEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  approvedBy           PosEmployee?           @relation("PosItemReturnApprover", fields: [approvedByEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  lines                PosOrderItemReturnLine[]

  @@unique([id, orderId, merchantId])
  @@unique([merchantId, requestId])
