  unitCode         String                               @db.VarChar(32)
  quantity         Decimal                              @db.Decimal(18, 6)
  baseQuantity     Decimal                              @db.Decimal(18, 6)
  baseUnit         String                               @db.VarChar(16)
  position         Int
  assignmentOption ProductModifierGroupAssignmentOption @relation(fields: [assignmentId, optionId, merchantId], references: [assignmentId, optionId, merchantId], onDelete: Cascade)
  variant          ProductVariant?                      @relation(fields: [variantId, productId, merchantId], references: [id, productId, merchantId], onDelete: Cascade)
  stockItem        StockItem                            @relation(fields: [stockItemId, merchantId], references: [id, merchantId], onDelete: Restrict)
  assignment       ProductModifierGroupAssignment       @relation(fields: [assignmentId, productId, merchantId], references: [id, productId, merchantId], onDelete: Cascade)

  @@index([assignmentId, optionId, merchantId])
  @@index([stockItemId, merchantId])
  @@index([variantId, productId, merchantId])
  @@map("product_modifier_effects")
}

model StorefrontOrderAction {
  id          String          @id @default(uuid()) @db.Uuid
  merchantId  String          @db.Uuid
  orderId     String          @db.Uuid
  requestId   String          @db.Uuid
  action      String          @db.VarChar(24)
  fingerprint String          @db.VarChar(64)
  result      Json
  createdBy   String          @db.VarChar(80)
  approvedByPosEmployeeId String? @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  order       StorefrontOrder @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  approvedBy PosEmployee? @relation("PosOrderActionApprover", fields: [approvedByPosEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict, map: "storefront_order_actions_approver_fkey")

  @@unique([merchantId, requestId])
  @@index([orderId, merchantId, createdAt])
  @@map("storefront_order_actions")
}

model StorefrontOrderStockBatch {
  orderId    String             @db.Uuid
  merchantId String             @db.Uuid
  batchId    String             @db.Uuid
  role       String             @db.VarChar(16)
  position   Int
  order      StorefrontOrder    @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  batch      StockMovementBatch @relation(fields: [batchId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@id([orderId, role, position])
  @@unique([batchId])
  @@index([merchantId, orderId])
  @@map("storefront_order_stock_batches")
}

// Treasury stays separate from immutable shift-close snapshots.
model PosCashSafe {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(80)
  createdBy String @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  transfers PosCashTransfer[]
  movements PosCashSafeMovement[]
  @@unique([id, branchId, merchantId])
  @@unique([merchantId, branchId, name])
  @@map("pos_cash_safes")
}

model PosCashTransfer {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @db.Uuid
  branchId String @db.Uuid
  requestId String @db.Uuid
  fingerprint String @db.VarChar(64)
  sourceShiftId String @db.Uuid
  destinationSafeId String? @db.Uuid
  destinationShiftId String? @unique @db.Uuid
  manualMovementId String? @unique @db.Uuid
  amount Decimal @db.Decimal(12, 2)
  receivedAmount Decimal? @db.Decimal(12, 2)
  status String @default("pending") @db.VarChar(16)
  reference String @db.VarChar(80)
  reason String @db.VarChar(500)
  createdBy String @db.VarChar(160)
  receivedBy String? @db.VarChar(160)
  receivedAt DateTime? @db.Timestamptz(6)
  receiptRequestId String? @db.Uuid
  receiptFingerprint String? @db.VarChar(64)
  receiptNote String? @db.VarChar(500)
  resolvedBy String? @db.VarChar(160)
  resolutionNote String? @db.VarChar(500)
  resolvedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  sourceShift PosShift @relation("CashTransferSource", fields: [sourceShiftId, branchId, merchantId], references: [id, branchId, merchantId], onDelete: Restrict)
  destinationShift PosShift? @relation("CashTransferDestination", fields: [destinationShiftId, branchId, merchantId], references: [id, branchId, merchantId], onDelete: Restrict)
  destinationSafe PosCashSafe? @relation(fields: [destinationSafeId, branchId, merchantId], references: [id, branchId, merchantId], onDelete: Restrict)
  manualMovement PosShiftManualCashMovement? @relation(fields: [manualMovementId, sourceShiftId, merchantId], references: [id, shiftId, merchantId], onDelete: Restrict)
  safeMovement PosCashSafeMovement?
  @@unique([destinationShiftId, branchId, merchantId])
  @@unique([manualMovementId, sourceShiftId, merchantId])
  @@unique([id, merchantId])
  @@unique([merchantId, requestId])
  @@unique([merchantId, receiptRequestId])
  @@index([merchantId, branchId, createdAt, id])
  @@map("pos_cash_transfers")
}

model PosCashSafeMovement {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @db.Uuid
  branchId String @db.Uuid
  safeId String @db.Uuid
  requestId String @db.Uuid
  transferId String? @unique @db.Uuid
  kind String @db.VarChar(16)
  amount Decimal @db.Decimal(12, 2)
  reason String @db.VarChar(500)
  createdBy String @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  safe PosCashSafe @relation(fields: [safeId, branchId, merchantId], references: [id, branchId, merchantId], onDelete: Restrict)
  transfer PosCashTransfer? @relation(fields: [transferId, merchantId], references: [id, merchantId], onDelete: Restrict)
  @@unique([transferId, merchantId])
  @@unique([merchantId, requestId])
  @@index([merchantId, safeId, createdAt, id])
  @@map("pos_cash_safe_movements")
}

// Storefront-owned public restaurant settings. Reference metadata is explicitly demo-only.
model RestaurantProfile {
  merchantId String @id @db.Uuid
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  description String @default("") @db.VarChar(1000)
  cuisines String[] @default([])
  logoImage Json?
  coverImage Json?
  published Boolean @default(false)
  displayOrder Int @default(0)
  timezone String @default("Africa/Cairo") @db.VarChar(80)
  alwaysOpen Boolean @default(false)
  openingHours Json @default("[]")
  scheduleExceptions Json @default("[]")
  ordersPaused Boolean @default(false)
  pauseReason String? @db.VarChar(500)
  deliveryEnabled Boolean @default(true)
  pickupEnabled Boolean @default(true)
  deliveryFee Decimal @default(0) @db.Decimal(12,2)
  minimumDeliveryOrder Decimal @default(0) @db.Decimal(12,2)
  deliveryTimeMinMinutes Int @default(0)
  deliveryTimeMaxMinutes Int @default(0)
  deliveryAreas Json @default("[]")
  referenceData Json?
  revision Int @default(1)
  updatedBy String @db.VarChar(80)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@index([published, displayOrder, merchantId])
  @@map("restaurant_profiles")
}
