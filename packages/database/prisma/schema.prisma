}

// Cash outflows are negative and belong to the open shift that issued the refund.
model PosShiftRefundMovement {
  id                 String               @id @default(uuid()) @db.Uuid
  merchantId         String               @db.Uuid
  shiftId            String               @db.Uuid
  refundTenderId     String               @db.Uuid
  operatorEmployeeId String               @db.Uuid
  amount             Decimal              @db.Decimal(12, 2)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  merchant           Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  shift              PosShift             @relation(fields: [shiftId, merchantId], references: [id, merchantId], onDelete: Restrict)
  refundTender       PosOrderRefundTender @relation(fields: [refundTenderId, shiftId, merchantId], references: [id, shiftId, merchantId], onDelete: Restrict)
  operator           PosEmployee          @relation(fields: [operatorEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([refundTenderId])
  @@unique([refundTenderId, shiftId, merchantId])
  @@index([merchantId, shiftId, createdAt])
  @@map("pos_shift_refund_movements")
}

// Cash-in/out adjustments require a reason and supervisor authorization when entered by a cashier.
model PosShiftManualCashMovement {
  safeTransfer PosCashTransfer?
  id                   String       @id @default(uuid()) @db.Uuid
  merchantId           String       @db.Uuid
  shiftId              String       @db.Uuid
  requestId            String       @db.Uuid
  fingerprint          String       @db.VarChar(64)
  kind                 String       @db.VarChar(12)
