generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// Infrastructure-only marker keeps the Prisma generator and migration toolchain verifiable.
// It has no business meaning and contains no merchant or customer data.
model FoundationMarker {
  id Int @id @default(dbgenerated("nextval('_waffarly_foundation_marker_id_seq'::regclass)"))

  @@map("_waffarly_foundation_marker")
}

model PosOrderBranchCode {
  merchantId String @db.Uuid
  branchId String @db.Uuid
  code Int @unique @default(autoincrement())
  branch Branch @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  @@id([merchantId, branchId])
  @@map("pos_order_branch_codes")
}

model PosOrderDailyCounter {
  merchantId String @db.Uuid
  branchId String @db.Uuid
  businessDate DateTime @db.Date
  lastNumber Int
  branch Branch @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  @@id([merchantId, branchId, businessDate])
  @@map("pos_order_daily_counters")
}

// A merchant is the tenant boundary across business activities.
model Merchant {
  subscription Subscription?
  cashSafes PosCashSafe[]
  id                       String                  @id @default(uuid()) @db.Uuid
  name                     String                  @db.VarChar(160)
  storefrontSlug           String                  @unique @db.VarChar(120)
  storefrontHandle         String?                 @unique @db.VarChar(63)
  storefrontHandleAssignedAt DateTime?             @db.Timestamptz(6)
  storefrontHandleAssignedBy String?               @db.VarChar(80)
  activity                 String                  @default("other") @db.VarChar(32)
  contactPhone             String                  @db.VarChar(32)
  ownerName                String                  @db.VarChar(160)
  ownerMobile              String                  @db.VarChar(32)
  firstMonthActivatedAt    DateTime?               @db.Timestamptz(6)
  firstMonthActivatedBy    String?                 @db.VarChar(80)
  createdAt                DateTime                @default(now()) @db.Timestamptz(6)
  profileRevision          Int                     @default(1)
  profileUpdatedAt         DateTime?               @db.Timestamptz(6)
  profileUpdatedBy         String?                 @db.VarChar(80)
  owner                    OwnerAccount?
  posEmployees             PosEmployee[]
  application              MerchantApplication?
  restaurantProfile        RestaurantProfile?
  storefront               MerchantStorefront?
  mediaAssets              MediaAsset[]
  categories               Category[]
  products                 Product[]
  modifierGroups           ModifierGroup[]
  storefrontOrders         StorefrontOrder[]
  stockItems               StockItem[]
  branches                 Branch[]
  warehouses               Warehouse[]
  stockBalances            StockBalance[]
  stockReorderThresholds   StockReorderThreshold[]
  stockMovementBatches     StockMovementBatch[]
  purchaseSuppliers        PurchaseSupplier[]
  purchaseInvoices         PurchaseInvoice[]
  posRegisters             PosRegister[]
  posShifts                PosShift[]
  posDiningTables          PosDiningTable[]
  posDiningSessions        PosDiningSession[]
  posKitchenStations       PosKitchenStation[]
  posKitchenTickets        PosKitchenTicket[]
  posOrderChecks           PosOrderCheck[]
  posCheckReceipts         PosCheckReceipt[]
  posOrderPayments         PosOrderPayment[]
  posShiftCashMovements    PosShiftCashMovement[]
  posOrderRefunds          PosOrderRefund[]
  posItemReturns           PosOrderItemReturn[]
  posOrderRefundTenders    PosOrderRefundTender[]
  posShiftRefundMovements  PosShiftRefundMovement[]
  posShiftManualCashMovements PosShiftManualCashMovement[]
  posShiftCloseReports    PosShiftCloseReport[]
  negativeStockPolicy      String                  @default("allow") @db.VarChar(16)
  inventoryPolicyRevision  Int                     @default(1)
  inventoryPolicyUpdatedBy String?                 @db.VarChar(80)
  inventoryPolicyUpdatedAt DateTime?               @db.Timestamptz(6)
  posAccent                String                  @default("orange") @db.VarChar(16)
  posAppearanceRevision    Int                     @default(1)
  posAppearanceUpdatedBy   String?                 @db.VarChar(80)
  posAppearanceUpdatedAt   DateTime                @default(now()) @db.Timestamptz(6)

  @@map("merchants")
}

// Inventory identities only; item creation does not establish stock balances.
model StockItem {
  id                    String                                @id @default(uuid()) @db.Uuid
  merchantId            String                                @db.Uuid
  creationRequest       String                                @db.Uuid
  creationFingerprint   String                                @db.VarChar(64)
  name                  String                                @db.VarChar(160)
  description           String?                               @db.VarChar(1000)
  baseUnit              String                                @db.VarChar(16)
  archivedAt            DateTime?                             @db.Timestamptz(6)
  revision              Int                                   @default(1)
  createdBy             String                                @db.VarChar(80)
  updatedBy             String                                @db.VarChar(80)
  createdAt             DateTime                              @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                              @updatedAt @db.Timestamptz(6)
  merchant              Merchant                              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  units                 StockItemUnit[]
  balances              StockBalance[]
  reorderThresholds     StockReorderThreshold[]
  movements             StockMovement[]
  purchaseInvoiceLines  PurchaseInvoiceLine[]
  productComponents     ProductInventoryComponent[]
  modifierEffects       ProductModifierEffect[]
  orderLineRequirements StorefrontOrderLineStockRequirement[]

  @@unique([id, merchantId])
  @@unique([merchantId, creationRequest])
  @@index([merchantId, archivedAt, createdAt, id])
  @@map("stock_items")
}

// An item-specific pack expressed directly in immutable base units.
model StockItemUnit {
  id           String    @id @default(uuid()) @db.Uuid
  stockItemId  String    @db.Uuid
  merchantId   String    @db.Uuid
  code         String    @db.VarChar(32)
  name         String    @db.VarChar(80)
  baseQuantity Decimal   @db.Decimal(18, 6)
  createdBy    String    @db.VarChar(80)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  stockItem    StockItem @relation(fields: [stockItemId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([stockItemId, code])
  @@unique([id, stockItemId, merchantId])
  @@map("stock_item_units")
}

// A merchant location. Every branch has one active default consumption warehouse, enforced in the Inventory API.
model Branch {
  posOrderBranchCodes PosOrderBranchCode[]
  posOrderDailyCounters PosOrderDailyCounter[]
  cashSafes PosCashSafe[]
  deliveries        PosDelivery[]
  id                String              @id @default(uuid()) @db.Uuid
  merchantId        String              @db.Uuid
  name              String              @db.VarChar(160)
  address           String?             @db.VarChar(500)
  archivedAt        DateTime?           @db.Timestamptz(6)
  revision          Int                 @default(1)
  createdBy         String              @db.VarChar(80)
  updatedBy         String              @db.VarChar(80)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(6)
  merchant          Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  warehouses        Warehouse[]
  recipeOrders      StorefrontOrder[]
  posEmployees      PosEmployeeBranch[]
  posRegisters      PosRegister[]
  posShifts         PosShift[]
  posDiningTables   PosDiningTable[]
  posDiningSessions PosDiningSession[]
  kitchenStations   PosKitchenStation[]
  kitchenTickets    PosKitchenTicket[]

  @@unique([id, merchantId])
  @@unique([merchantId, name])
  @@index([merchantId, archivedAt, createdAt, id])
  @@map("branches")
}

// Warehouses remain distinct even when a branch currently operates one location.
model Warehouse {
  id                   String                  @id @default(uuid()) @db.Uuid
  merchantId           String                  @db.Uuid
  branchId             String                  @db.Uuid
  name                 String                  @db.VarChar(160)
  isDefaultConsumption Boolean                 @default(false)
  archivedAt           DateTime?               @db.Timestamptz(6)
  revision             Int                     @default(1)
  createdBy            String                  @db.VarChar(80)
  updatedBy            String                  @db.VarChar(80)
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(6)
  branch               Branch                  @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  merchant             Merchant                @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  balances             StockBalance[]
  reorderThresholds    StockReorderThreshold[]
  movements            StockMovement[]
  purchaseInvoices     PurchaseInvoice[]
  recipeOrders         StorefrontOrder[]

  @@unique([id, merchantId])
  @@unique([id, branchId, merchantId])
  @@unique([branchId, name])
  @@index([merchantId, branchId, archivedAt, createdAt, id])
  @@map("warehouses")
}

// Cached quantities by warehouse, Stock Item, and condition; movement and balance writes are atomic.
model StockBalance {
  id          String    @id @default(uuid()) @db.Uuid
  merchantId  String    @db.Uuid
  warehouseId String    @db.Uuid
  stockItemId String    @db.Uuid
  condition   String    @db.VarChar(24)
  quantity    Decimal   @default(0) @db.Decimal(18, 6)
  updatedBy   String    @db.VarChar(80)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId, merchantId], references: [id, merchantId], onDelete: Restrict)
  stockItem   StockItem @relation(fields: [stockItemId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([id, merchantId])
  @@unique([merchantId, warehouseId, stockItemId, condition])
  @@index([merchantId, warehouseId, createdAt, id])
  @@map("stock_balances")
}

// A reorder point is configured for one item in one warehouse, in that item's base unit.
model StockReorderThreshold {
  id                       String    @id @default(uuid()) @db.Uuid
  merchantId               String    @db.Uuid
  warehouseId              String    @db.Uuid
  stockItemId              String    @db.Uuid
  minimumAvailableQuantity Decimal   @db.Decimal(18, 6)
  revision                 Int       @default(1)
  createdBy                String    @db.VarChar(80)
  updatedBy                String    @db.VarChar(80)
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)
  merchant                 Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  warehouse                Warehouse @relation(fields: [warehouseId, merchantId], references: [id, merchantId], onDelete: Restrict)
  stockItem                StockItem @relation(fields: [stockItemId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([id, merchantId])
  @@unique([merchantId, warehouseId, stockItemId])
  @@index([merchantId, warehouseId, createdAt, id])
  @@map("stock_reorder_thresholds")
}

// One attributable, retry-safe posting containing one or more immutable movements.
model StockMovementBatch {
  id          String                      @id @default(uuid()) @db.Uuid
  merchantId  String                      @db.Uuid
  requestId   String                      @db.Uuid
  sourceType  String                      @db.VarChar(32)
  sourceId    String                      @db.VarChar(80)
  fingerprint String                      @db.VarChar(64)
  kind        String                      @db.VarChar(32)
  reason      String                      @db.VarChar(500)
  createdBy   String                      @db.VarChar(80)
  createdAt   DateTime                    @default(now()) @db.Timestamptz(6)
  merchant    Merchant                    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  movements   StockMovement[]
  orderLinks  StorefrontOrderStockBatch[]

  @@unique([id, merchantId])
  @@unique([merchantId, requestId])
  @@unique([merchantId, sourceType, sourceId])
  @@index([merchantId, createdAt, id])
  @@map("stock_movement_batches")
}

// Append-only signed base-unit delta; the related batch keeps user-entered unit and reason history.
model StockMovement {
  id              String             @id @default(uuid()) @db.Uuid
  merchantId      String             @db.Uuid
  batchId         String             @db.Uuid
  warehouseId     String             @db.Uuid
  stockItemId     String             @db.Uuid
  warehouseName   String             @db.VarChar(160)
  branchName      String             @db.VarChar(160)
  stockItemName   String             @db.VarChar(160)
  baseUnit        String             @db.VarChar(16)
  condition       String             @db.VarChar(24)
  unitCode        String             @db.VarChar(32)
  enteredQuantity Decimal            @db.Decimal(18, 6)
  baseDelta       Decimal            @db.Decimal(18, 6)
  position        Int
  createdBy       String             @db.VarChar(80)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  batch           StockMovementBatch @relation(fields: [batchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  warehouse       Warehouse          @relation(fields: [warehouseId, merchantId], references: [id, merchantId], onDelete: Restrict)
  stockItem       StockItem          @relation(fields: [stockItemId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([batchId, position])
  @@index([merchantId, warehouseId, createdAt, id])
  @@index([merchantId, stockItemId, createdAt, id])
  @@map("stock_movements")
}

model PurchaseSupplier {
  id                  String            @id @default(uuid()) @db.Uuid
  merchantId          String            @db.Uuid
  creationRequest     String            @db.Uuid
  creationFingerprint String            @db.VarChar(64)
  name                String            @db.VarChar(160)
  nameKey             String            @db.VarChar(160)
  contactName         String?           @db.VarChar(160)
  phone               String?           @db.VarChar(32)
  email               String?           @db.VarChar(254)
  address             String?           @db.VarChar(500)
  archivedAt          DateTime?         @db.Timestamptz(6)
  revision            Int               @default(1)
  createdBy           String            @db.VarChar(80)
  updatedBy           String            @db.VarChar(80)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)
  merchant            Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  invoices            PurchaseInvoice[]

  @@unique([id, merchantId])
  @@unique([merchantId, creationRequest])
  @@unique([merchantId, nameKey])
  @@index([merchantId, archivedAt, createdAt, id])
  @@map("purchase_suppliers")
}

model PurchaseInvoice {
  id                       String                @id @default(uuid()) @db.Uuid
  merchantId               String                @db.Uuid
  supplierId               String                @db.Uuid
  supplierName             String                @db.VarChar(160)
  supplierInvoiceNumber    String?               @db.VarChar(100)
  supplierInvoiceNumberKey String?               @db.VarChar(100)
  warehouseId              String                @db.Uuid
  warehouseName            String                @db.VarChar(160)
  branchName               String                @db.VarChar(160)
  creationRequest          String                @db.Uuid
  creationFingerprint      String                @db.VarChar(64)
  status                   String                @default("draft") @db.VarChar(16)
  revision                 Int                   @default(1)
  confirmedAt              DateTime?             @db.Timestamptz(6)
  confirmedBy              String?               @db.VarChar(80)
  createdBy                String                @db.VarChar(80)
  updatedBy                String                @db.VarChar(80)
  createdAt                DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @db.Timestamptz(6)
  merchant                 Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  supplier                 PurchaseSupplier      @relation(fields: [supplierId, merchantId], references: [id, merchantId], onDelete: Restrict)
  warehouse                Warehouse             @relation(fields: [warehouseId, merchantId], references: [id, merchantId], onDelete: Restrict)
  lines                    PurchaseInvoiceLine[]

  @@unique([id, merchantId])
  @@unique([merchantId, creationRequest])
  @@unique([merchantId, supplierId, supplierInvoiceNumberKey])
  @@index([merchantId, status, createdAt, id])
  @@index([merchantId, supplierId, createdAt, id])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id            String          @id @default(uuid()) @db.Uuid
  merchantId    String          @db.Uuid
  invoiceId     String          @db.Uuid
  stockItemId   String          @db.Uuid
  stockItemName String          @db.VarChar(160)
  baseUnit      String          @db.VarChar(16)
  unitCode      String          @db.VarChar(32)
  unitName      String          @db.VarChar(80)
  condition     String          @db.VarChar(24)
  quantity      Decimal         @db.Decimal(18, 6)
  position      Int
  invoice       PurchaseInvoice @relation(fields: [invoiceId, merchantId], references: [id, merchantId], onDelete: Restrict)
  stockItem     StockItem       @relation(fields: [stockItemId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([invoiceId, position])
  @@unique([invoiceId, stockItemId, condition])
  @@index([merchantId, stockItemId, invoiceId])
  @@map("purchase_invoice_lines")
}

// Public merchant applications remain separate from merchant tenants until approval.
model MerchantApplication {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(160)
  activity        String    @default("other") @db.VarChar(32)
  contactPhone    String    @db.VarChar(32)
  ownerName       String    @db.VarChar(160)
  ownerMobile     String    @db.VarChar(32)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  approvedAt      DateTime? @db.Timestamptz(6)
  approvedBy      String?   @db.VarChar(80)
  rejectedAt      DateTime? @db.Timestamptz(6)
  rejectedBy      String?   @db.VarChar(80)
  rejectionReason String?   @db.Text
  merchantId      String?   @unique @db.Uuid
  merchant        Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("merchant_applications")
}

model OwnerAccount {
  id           String   @id @default(uuid()) @db.Uuid
  merchantId   String   @unique @db.Uuid
  username     String   @unique @db.VarChar(80)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@map("owner_accounts")
}

// POS staff authenticate within their merchant and receive access only to assigned branches.
model PosEmployee {
  deliveryCustodies PosDelivery[]
  deliveryRemittances PosDeliveryRemittance[]
  id                   String                 @id @default(uuid()) @db.Uuid
  merchantId           String                 @db.Uuid
  username             String                 @db.VarChar(80)
  displayName          String                 @db.VarChar(160)
  passwordHash         String                 @db.VarChar(255)
  role                 String?                @db.VarChar(24)
  permissions          String[]               @default([])
  active               Boolean                @default(true)
  revision             Int                    @default(1)
  createdBy            String                 @db.VarChar(80)
  updatedBy            String                 @db.VarChar(80)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)
  merchant             Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branches             PosEmployeeBranch[]
  openedShifts         PosShift[]
  openedDiningSessions PosDiningSession[]
  posOrders            StorefrontOrder[]
  dispatchedKitchenTickets PosKitchenTicket[]
  approvedOrderActions StorefrontOrderAction[] @relation("PosOrderActionApprover")
  acknowledgedKitchenCancellations PosKitchenTicket[] @relation("PosKitchenCancellationAcknowledger")
  posPayments          PosOrderPayment[]
  cashMovements        PosShiftCashMovement[]
  issuedReceipts       PosCheckReceipt[]
  issuedRefunds        PosOrderRefund[] @relation("PosRefundIssuer")
  approvedRefunds      PosOrderRefund[] @relation("PosRefundApprover")
  issuedItemReturns    PosOrderItemReturn[] @relation("PosItemReturnIssuer")
  approvedItemReturns  PosOrderItemReturn[] @relation("PosItemReturnApprover")
  refundCashMovements  PosShiftRefundMovement[]
  manualCashMovements  PosShiftManualCashMovement[] @relation("PosShiftCashMovementOperator")
  approvedCashMovements PosShiftManualCashMovement[] @relation("PosShiftCashMovementApprover")
  closedShiftReports   PosShiftCloseReport[] @relation("PosShiftCloseOperator")
  approvedShiftCloses  PosShiftCloseReport[] @relation("PosShiftCloseApprover")

  @@unique([id, merchantId])
  @@unique([merchantId, username])
  @@index([merchantId, active, createdAt, id])
  @@map("pos_employees")
}

model PosEmployeeBranch {
  employeeId String      @db.Uuid
  merchantId String      @db.Uuid
  branchId   String      @db.Uuid
  createdBy  String      @db.VarChar(80)
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)
  employee   PosEmployee @relation(fields: [employeeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  branch     Branch      @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@id([employeeId, branchId])
  @@index([merchantId, branchId, employeeId])
  @@map("pos_employee_branches")
}

// A merchant-managed till identity anchored to one branch.
model PosRegister {
  id         String     @id @default(uuid()) @db.Uuid
  merchantId String     @db.Uuid
  branchId   String     @db.Uuid
  name       String     @db.VarChar(80)
  active     Boolean    @default(true)
  revision   Int        @default(1)
  createdBy  String     @db.VarChar(80)
  updatedBy  String     @db.VarChar(80)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(6)
  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  shifts     PosShift[]

  @@unique([id, merchantId])
  @@unique([id, branchId, merchantId])
  @@unique([branchId, name])
  @@index([merchantId, branchId, active, createdAt, id])
  @@map("pos_registers")
}

// One active shift is enforced per register by a partial PostgreSQL unique index.
model PosShift {
  outgoingTransfers PosCashTransfer[] @relation("CashTransferSource")
  incomingTransfer PosCashTransfer? @relation("CashTransferDestination")
  deliveryFollowups PosDelivery[]
  deliveryRemittances PosDeliveryRemittance[]
  id                 String                 @id @default(uuid()) @db.Uuid
  merchantId         String                 @db.Uuid
  branchId           String                 @db.Uuid
  registerId         String                 @db.Uuid
  openRequestId      String                 @db.Uuid
  openedByEmployeeId String                 @db.Uuid
  openingFloat       Decimal                @db.Decimal(12, 2)
  currency           String                 @default("EGP") @db.Char(3)
  status             String                 @default("open") @db.VarChar(12)
  openedAt           DateTime               @default(now()) @db.Timestamptz(6)
  closedAt           DateTime?              @db.Timestamptz(6)
  merchant           Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branch             Branch                 @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  register           PosRegister            @relation(fields: [registerId, branchId, merchantId], references: [id, branchId, merchantId], onDelete: Restrict)
  openedBy           PosEmployee            @relation(fields: [openedByEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  orders             StorefrontOrder[]
  payments           PosOrderPayment[]
  cashMovements      PosShiftCashMovement[]
  refunds            PosOrderRefund[]
  refundCashMovements PosShiftRefundMovement[]
  manualCashMovements PosShiftManualCashMovement[]
  closeReport        PosShiftCloseReport?

  @@unique([id, merchantId])
  @@unique([merchantId, openRequestId])
  @@unique([id, branchId, merchantId])
  @@index([merchantId, registerId, status, openedAt])
  @@index([merchantId, openedByEmployeeId, openedAt])
  @@map("pos_shifts")
}

// Tables are configured per branch; occupancy is held by the active dining session.
model PosDiningTable {
  id         String             @id @default(uuid()) @db.Uuid
  merchantId String             @db.Uuid
  branchId   String             @db.Uuid
  code       String             @db.VarChar(32)
  capacity   Int                @default(2)
  active     Boolean            @default(true)
  revision   Int                @default(1)
  createdBy  String             @db.VarChar(80)
  updatedBy  String             @db.VarChar(80)
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(6)
  merchant   Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branch     Branch             @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  sessions   PosDiningSession[]

  @@unique([id, branchId, merchantId])
  @@unique([branchId, code])
  @@index([merchantId, branchId, active, code])
  @@map("pos_dining_tables")
}

// A session owns one table until every order/check is resolved and the session closes.
model PosDiningSession {
  id                 String            @id @default(uuid()) @db.Uuid
  merchantId         String            @db.Uuid
  branchId           String            @db.Uuid
  tableId            String            @db.Uuid
  openedByEmployeeId String            @db.Uuid
  status             String            @default("open") @db.VarChar(12)
  revision           Int               @default(1)
  openedAt           DateTime          @default(now()) @db.Timestamptz(6)
  closedAt           DateTime?         @db.Timestamptz(6)
  merchant           Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branch             Branch            @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  table              PosDiningTable    @relation(fields: [tableId, branchId, merchantId], references: [id, branchId, merchantId], onDelete: Restrict)
  openedBy           PosEmployee       @relation(fields: [openedByEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  orders             StorefrontOrder[]

  @@unique([id, merchantId])
  @@unique([id, branchId, merchantId])
  @@index([merchantId, branchId, status, openedAt])
  @@index([merchantId, tableId, status])
  @@map("pos_dining_sessions")
}

// The first release routes every branch order to its single default kitchen station.
model PosKitchenStation {
  id        String             @id @default(uuid()) @db.Uuid
  merchantId String            @db.Uuid
  branchId  String             @db.Uuid
  code      String             @db.VarChar(48)
  name      String             @db.VarChar(120)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)
  merchant  Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  tickets   PosKitchenTicket[]

  @@unique([id, merchantId])
  @@unique([id, branchId, merchantId])
  @@unique([merchantId, branchId, code])
  @@index([merchantId, branchId, active])
  @@map("pos_kitchen_stations")
}

// One ticket references a confirmed immutable POS round; the order remains the item snapshot source.
model PosKitchenTicket {
  id                        String            @id @default(uuid()) @db.Uuid
  merchantId                String            @db.Uuid
  branchId                  String            @db.Uuid
  stationId                 String            @db.Uuid
  orderId                   String            @db.Uuid
  dispatchMode              String            @db.VarChar(16)
  dispatchedByPosEmployeeId String?           @db.Uuid
  dispatchedAt              DateTime          @default(now()) @db.Timestamptz(6)
  cancellationAcknowledgedAt DateTime? @db.Timestamptz(6)
  cancellationAcknowledgedByPosEmployeeId String? @db.Uuid
  createdAt                 DateTime          @default(now()) @db.Timestamptz(6)
  merchant                  Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branch                    Branch            @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  station                   PosKitchenStation @relation(fields: [stationId, branchId, merchantId], references: [id, branchId, merchantId], onDelete: Restrict)
  order                     StorefrontOrder   @relation(fields: [orderId, branchId, merchantId], references: [id, branchId, merchantId], onDelete: Restrict)
  dispatchedBy              PosEmployee?      @relation(fields: [dispatchedByPosEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  cancellationAcknowledgedBy PosEmployee? @relation("PosKitchenCancellationAcknowledger", fields: [cancellationAcknowledgedByPosEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict, map: "pos_kitchen_cancel_ack_employee_fkey")

  @@unique([id, merchantId])
  @@unique([orderId, merchantId])
  @@unique([orderId, branchId, merchantId])
  @@index([merchantId, branchId, dispatchedAt, id])
  @@map("pos_kitchen_tickets")
}

// Opaque tokens are stored only as hashes. Admin identity is configured outside the database.
model AuthSession {
  tokenHash   String   @id @db.VarChar(64)
  subjectKind String   @db.VarChar(10)
  subjectId   String   @db.VarChar(80)
  expiresAt   DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([subjectKind, subjectId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// Platform-owned presentation definitions. Tenant choices are persisted separately; publication is distinct.
model StorefrontTemplate {
  id          String               @id @default(uuid()) @db.Uuid
  key         String               @unique @db.VarChar(80)
  name        String               @db.VarChar(160)
  description String               @db.VarChar(1000)
  activity    String               @db.VarChar(32)
  layout      String               @db.VarChar(32)
  accentColor String               @db.VarChar(7)
  status      String               @default("draft") @db.VarChar(16)
  revision    Int                  @default(1)
  updatedBy   String               @db.VarChar(80)
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(6)
  merchants   MerchantStorefront[]

  @@index([activity, status])
  @@map("storefront_templates")
}

// Merchant-specific choices are separate from the shared presentation definition.
model MerchantStorefront {
  merchantId  String             @id @db.Uuid
  templateId  String             @db.Uuid
  accentColor String             @db.VarChar(7)
  logoData    String?            @db.Text
  revision    Int                @default(1)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  merchant    Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  template    StorefrontTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@map("merchant_storefronts")
}

// Commercial definitions only. Merchant coverage and collection are separate concerns.
model MonthlyPlan {
  assignedSubscriptions Subscription[] @relation("AssignedSubscriptionPlan")
  subscriptionPeriods SubscriptionPeriod[] @relation("SubscriptionPeriodPlan")
  available       Boolean  @default(true)
  terms           PlanTerm[]
  id              String   @id @default(uuid()) @db.Uuid
  creationRequest String   @unique @db.Uuid
  name            String   @db.VarChar(160)
  description     String   @db.VarChar(1000)
  monthlyPrice    Decimal  @db.Decimal(10, 2)
  currency        String   @default("EGP") @db.VarChar(3)
  billingInterval String   @default("monthly") @db.VarChar(16)
  revision        Int      @default(1)
  createdBy       String   @db.VarChar(80)
  updatedBy       String   @db.VarChar(80)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@map("monthly_plans")
}

model PlanTerm {
  planId String @db.Uuid
  months Int
  price Decimal @db.Decimal(10, 2)
  plan MonthlyPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([planId, months])
  @@map("plan_terms")
}

model Subscription {
  merchantId String @id @db.Uuid
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  status String @default("pending") @db.VarChar(16)
  revision Int @default(1)
  cancelAtEnd Boolean @default(false)
  assignedPlanId String? @db.Uuid
  assignedPlan MonthlyPlan? @relation("AssignedSubscriptionPlan", fields: [assignedPlanId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignedMonths Int?
  periods SubscriptionPeriod[]
  events SubscriptionEvent[]
  @@map("subscriptions")
}

model SubscriptionPeriod {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @db.Uuid
  subscription Subscription @relation(fields: [merchantId], references: [merchantId], onDelete: Restrict, onUpdate: NoAction)
  planId String @db.Uuid
  plan MonthlyPlan @relation("SubscriptionPeriodPlan", fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  planName String @db.VarChar(160)
  months Int
  price Decimal @db.Decimal(10, 2)
  collected Decimal @db.Decimal(10, 2)
  credit Decimal @db.Decimal(10, 2)
  startsAt DateTime @db.Timestamptz(6)
  endsAt DateTime @db.Timestamptz(6)
  coverageEndsAt DateTime @db.Timestamptz(6)
  @@index([merchantId, startsAt, coverageEndsAt])
  @@map("subscription_periods")
}

model SubscriptionEvent {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @db.Uuid
  subscription Subscription @relation(fields: [merchantId], references: [merchantId], onDelete: Restrict, onUpdate: NoAction)
  requestId String @db.Uuid
  fingerprint String @db.VarChar(64)
  action String @db.VarChar(24)
  administrator String @db.VarChar(80)
  reason String @db.VarChar(1000)
  collected Decimal @default(0) @db.Decimal(10, 2)
  result Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([merchantId, requestId])
  @@index([merchantId, createdAt, id])
  @@map("subscription_events")
}

// Dashboard overrides of code-managed definitions. Applicability is catalog metadata only.
model BusinessActivity {
  key         String   @id @db.VarChar(80)
  name        String   @db.VarChar(160)
  description String   @db.VarChar(1000)
  moduleKeys  String[] @default([])
  revision    Int      @default(1)
  updatedBy   String   @db.VarChar(80)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("business_activities")
}

model PlatformModule {
  key         String   @id @db.VarChar(80)
  name        String   @db.VarChar(160)
  description String   @db.VarChar(1000)
  revision    Int      @default(1)
  updatedBy   String   @db.VarChar(80)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("platform_modules")
}

// Reusable tenant-owned media metadata. Binary storage is an infrastructure concern.
model MediaAsset {
  id            String         @id @default(uuid()) @db.Uuid
  merchantId    String         @db.Uuid
  storageKey    String         @db.VarChar(255)
  publicUrl     String         @db.Text
  mimeType      String         @db.VarChar(80)
  sizeBytes     Int
  createdBy     String         @db.VarChar(80)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  categories    Category[]
  productImages ProductImage[]

  @@unique([merchantId, storageKey])
  @@unique([id, merchantId])
  @@index([merchantId, createdAt])
  @@map("media_assets")
}

model Category {
  menuProducts Product[] @relation("MenuSection")
  displayOrder Int @default(0)
  id           String            @id @default(uuid()) @db.Uuid
  merchantId   String            @db.Uuid
  name         String            @db.VarChar(160)
  description  String?           @db.VarChar(1000)
  imageAssetId String            @db.Uuid
  parentId     String?           @db.Uuid
  availability String            @db.VarChar(16)
  archivedAt   DateTime?         @db.Timestamptz(6)
  revision     Int               @default(1)
  createdBy    String            @db.VarChar(80)
  updatedBy    String            @db.VarChar(80)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)
  merchant     Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  imageAsset   MediaAsset        @relation(fields: [imageAssetId, merchantId], references: [id, merchantId], onDelete: Restrict)
  parent       Category?         @relation("CategoryHierarchy", fields: [parentId, merchantId], references: [id, merchantId], onDelete: Restrict)
  children     Category[]        @relation("CategoryHierarchy")
  productLinks ProductCategory[]

  @@unique([id, merchantId])
  @@index([merchantId, availability, archivedAt])
  @@index([merchantId, parentId])
  @@map("categories")
}

model Product {
  referenceKey String? @unique @db.VarChar(160)
  displayOrder Int @default(0)
  menuSectionId String? @db.Uuid
  menuSection Category? @relation("MenuSection", fields: [menuSectionId, merchantId], references: [id, merchantId], onDelete: Restrict, map: "products_menu_section_tenant")
  id                             String                           @id @default(uuid()) @db.Uuid
  merchantId                     String                           @db.Uuid
  name                           String                           @db.VarChar(160)
  description                    String?                          @db.VarChar(1000)
  basePrice                      Decimal                          @db.Decimal(12, 2)
  sellingUnit                    String                           @default("piece") @db.VarChar(16)
  availability                   String                           @db.VarChar(16)
  archivedAt                     DateTime?                        @db.Timestamptz(6)
  revision                       Int                              @default(1)
  createdBy                      String                           @db.VarChar(80)
  updatedBy                      String                           @db.VarChar(80)
  createdAt                      DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                         @updatedAt @db.Timestamptz(6)
  merchant                       Merchant                         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  images                         ProductImage[]
  categoryLinks                  ProductCategory[]
  modifierGroups                 ProductModifierGroupAssignment[]
  variants                       ProductVariant[]
  variantAttributes              ProductVariantAttribute[]
  inventoryConfiguration         ProductInventoryConfiguration?
  inventoryConfigurationRequired Boolean                          @default(false)

  @@unique([id, merchantId])
  @@index([merchantId, availability, archivedAt])
  @@map("products")
}

// Shared merchant-owned choice definitions are attached to Products by assignments.
model ModifierGroup {
  id          String                           @id @default(uuid()) @db.Uuid
  merchantId  String                           @db.Uuid
  name        String                           @db.VarChar(160)
  description String?                          @db.VarChar(1000)
  revision    Int                              @default(1)
  createdAt   DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                         @updatedAt @db.Timestamptz(6)
  merchant    Merchant                         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  options     ModifierOption[]
  assignments ProductModifierGroupAssignment[]

  @@unique([id, merchantId])
  @@index([merchantId, name])
  @@map("modifier_groups")
}

model ModifierOption {
  id          String                                 @id @default(uuid()) @db.Uuid
  groupId     String                                 @db.Uuid
  merchantId  String                                 @db.Uuid
  name        String                                 @db.VarChar(160)
  position    Int                                    @default(0)
  group       ModifierGroup                          @relation(fields: [groupId, merchantId], references: [id, merchantId], onDelete: Restrict)
  assignments ProductModifierGroupAssignmentOption[]

  @@unique([id, groupId, merchantId])
  @@index([groupId, position])
  @@map("modifier_options")
}

// Selection rules and option pricing/defaults belong to a Product's use of a shared group.
model ProductModifierGroupAssignment {
  id              String                                 @id @default(uuid()) @db.Uuid
  productId       String                                 @db.Uuid
  modifierGroupId String                                 @db.Uuid
  merchantId      String                                 @db.Uuid
  selectionMode   String                                 @db.VarChar(16)
  minSelections   Int
  maxSelections   Int
  position        Int                                    @default(0)
  product         Product                                @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Cascade)
  modifierGroup   ModifierGroup                          @relation(fields: [modifierGroupId, merchantId], references: [id, merchantId], onDelete: Restrict)
  options         ProductModifierGroupAssignmentOption[]

  optionOverrides  ProductModifierOptionVariant[]
  effects          ProductModifierEffect[]
  variantOverrides ProductModifierGroupVariant[]

  @@unique([id, productId, merchantId])
  @@unique([id, modifierGroupId, merchantId])
  @@unique([productId, modifierGroupId])
  @@index([merchantId, productId])
  @@index([productId, position])
  @@map("product_modifier_group_assignments")
}

model ProductModifierGroupAssignmentOption {
  assignmentId     String                         @db.Uuid
  modifierGroupId  String                         @db.Uuid
  optionId         String                         @db.Uuid
  merchantId       String                         @db.Uuid
  priceAdjustment  Decimal                        @default(0) @db.Decimal(12, 2)
  defaultSelected  Boolean                        @default(false)
  maxQuantity      Int                            @default(1)
  variantOverrides ProductModifierOptionVariant[]
  effects          ProductModifierEffect[]
  assignment       ProductModifierGroupAssignment @relation(fields: [assignmentId, modifierGroupId, merchantId], references: [id, modifierGroupId, merchantId], onDelete: Cascade)
  option           ModifierOption                 @relation(fields: [optionId, modifierGroupId, merchantId], references: [id, groupId, merchantId], onDelete: Restrict)

  @@id([assignmentId, optionId])
  @@unique([assignmentId, optionId, merchantId])
  @@index([optionId])
  @@map("product_modifier_group_assignment_options")
}

// A product variant has a separately sellable identity, price, and optional inventory tracking.
model ProductVariant {
  id                  String                             @id @default(uuid()) @db.Uuid
  productId           String                             @db.Uuid
  merchantId          String                             @db.Uuid
  name                String                             @db.VarChar(160)
  sku                 String?                            @db.VarChar(80)
  barcode             String?                            @db.VarChar(80)
  price               Decimal                            @db.Decimal(12, 2)
  stockQuantity       Int?
  availability        String                             @default("available") @db.VarChar(16)
  position            Int                                @default(0)
  product             Product                            @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Cascade)
  attributeSelections ProductVariantAttributeSelection[]
  inventoryTargets    ProductInventoryTarget[]
  modifierGroups      ProductModifierGroupVariant[]
  modifierOptions     ProductModifierOptionVariant[]
  modifierEffects     ProductModifierEffect[]

  @@unique([merchantId, sku])
  @@unique([merchantId, barcode])
  @@unique([id, productId, merchantId])
  @@index([merchantId, productId])
  @@index([productId, position])
  @@map("product_variants")
}

// A saved product configuration applies one inventory mode to every sellable.
// Legacy products may remain available without a configuration until their owner opts in.
model ProductInventoryConfiguration {
  productId  String                   @db.Uuid
  merchantId String                   @db.Uuid
  mode       String                   @db.VarChar(16)
  createdAt  DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime                 @updatedAt @db.Timestamptz(6)
  product    Product                  @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Cascade)
  targets    ProductInventoryTarget[]

  @@id([productId, merchantId])
  @@map("product_inventory_configurations")
}

// A target represents a simple product (variantId null) or one product variant.
model ProductInventoryTarget {
  id            String                        @id @default(uuid()) @db.Uuid
  productId     String                        @db.Uuid
  merchantId    String                        @db.Uuid
  variantId     String?                       @db.Uuid
  configuration ProductInventoryConfiguration @relation(fields: [productId, merchantId], references: [productId, merchantId], onDelete: Cascade)
  variant       ProductVariant?               @relation(fields: [variantId, productId, merchantId], references: [id, productId, merchantId], onDelete: Restrict)
  components    ProductInventoryComponent[]

  @@unique([id, productId, merchantId])
  @@index([merchantId, productId])
  @@map("product_inventory_targets")
}

// DIRECT targets contain exactly one component; RECIPE targets contain ingredients.
// The product API validates mode-specific component counts and target coverage.
model ProductInventoryComponent {
  id           String                 @id @default(uuid()) @db.Uuid
  targetId     String                 @db.Uuid
  productId    String                 @db.Uuid
  merchantId   String                 @db.Uuid
  stockItemId  String                 @db.Uuid
  unitCode     String                 @db.VarChar(32)
  quantity     Decimal                @db.Decimal(18, 6)
  baseQuantity Decimal                @db.Decimal(18, 6)
  baseUnit     String                 @db.VarChar(16)
  position     Int                    @default(0)
  target       ProductInventoryTarget @relation(fields: [targetId, productId, merchantId], references: [id, productId, merchantId], onDelete: Cascade)
  stockItem    StockItem              @relation(fields: [stockItemId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([targetId, position])
  @@index([merchantId, stockItemId])
  @@map("product_inventory_components")
}

model ProductVariantAttribute {
  id         String                             @id @default(uuid()) @db.Uuid
  productId  String                             @db.Uuid
  merchantId String                             @db.Uuid
  name       String                             @db.VarChar(120)
  position   Int                                @default(0)
  product    Product                            @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Cascade)
  values     ProductVariantAttributeValue[]
  selections ProductVariantAttributeSelection[]

  @@unique([id, productId, merchantId])
  @@index([productId, position])
  @@map("product_variant_attributes")
}

model ProductVariantAttributeValue {
  id          String                             @id @default(uuid()) @db.Uuid
  attributeId String                             @db.Uuid
  productId   String                             @db.Uuid
  merchantId  String                             @db.Uuid
  value       String                             @db.VarChar(120)
  position    Int                                @default(0)
  attribute   ProductVariantAttribute            @relation(fields: [attributeId, productId, merchantId], references: [id, productId, merchantId], onDelete: Cascade)
  selections  ProductVariantAttributeSelection[]

  @@unique([id, attributeId, productId, merchantId])
  @@index([attributeId, position])
  @@map("product_variant_attribute_values")
}

model ProductVariantAttributeSelection {
  variantId   String                       @db.Uuid
  attributeId String                       @db.Uuid
  valueId     String                       @db.Uuid
  productId   String                       @db.Uuid
  merchantId  String                       @db.Uuid
  variant     ProductVariant               @relation(fields: [variantId, productId, merchantId], references: [id, productId, merchantId], onDelete: Cascade)
  attribute   ProductVariantAttribute      @relation(fields: [attributeId, productId, merchantId], references: [id, productId, merchantId], onDelete: Cascade)
  value       ProductVariantAttributeValue @relation(fields: [valueId, attributeId, productId, merchantId], references: [id, attributeId, productId, merchantId], onDelete: Cascade)

  @@id([variantId, attributeId])
  @@unique([variantId, valueId])
  @@index([merchantId, attributeId, valueId])
  @@map("product_variant_attribute_selections")
}

model ProductImage {
  id           String     @id @default(uuid()) @db.Uuid
  productId    String     @db.Uuid
  mediaAssetId String     @db.Uuid
  merchantId   String     @db.Uuid
  isPrimary    Boolean    @default(false)
  position     Int        @default(0)
  product      Product    @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Restrict)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([productId, mediaAssetId])
  @@index([merchantId, productId])
  @@index([productId, position])
  @@map("product_images")
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  merchantId String   @db.Uuid
  product    Product  @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Restrict)
  category   Category @relation(fields: [categoryId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([merchantId, productId])
  @@index([categoryId, productId])
  @@map("product_categories")
}

// Public storefront checkouts are snapshots so order history remains readable if catalog data changes.
model StorefrontOrder {
  requestId String? @db.Uuid
  requestFingerprint String? @db.VarChar(64)
  @@unique([merchantId, requestId])
  subtotal Decimal? @db.Decimal(12,2)
  deliveryFee Decimal? @db.Decimal(12,2)
  fulfillmentPolicy Json?

  delivery               PosDelivery?
  id                     String                      @id @default(uuid()) @db.Uuid
  orderReference         String?                     @db.VarChar(64)
  merchantId             String                      @db.Uuid
  customerName           String?                     @db.VarChar(120)
  customerPhone          String?                     @db.VarChar(32)
  fulfillmentType        String                      @db.VarChar(16)
  source                 String                      @default("storefront") @db.VarChar(16)
  posShiftId             String?                     @db.Uuid
  createdByPosEmployeeId String?                     @db.Uuid
  deliveryAddress        String?                     @db.Text
  posDiningSessionId     String?                     @db.Uuid
  status                 String                      @default("pending") @db.VarChar(16)
  currency               String                      @default("EGP") @db.VarChar(3)
  total                  Decimal                     @db.Decimal(12, 2)
  revision               Int                         @default(1)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(6)
  merchant               Merchant                    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  lines                  StorefrontOrderLine[]
  branchId               String?                     @db.Uuid
  warehouseId            String?                     @db.Uuid
  branchName             String?                     @db.VarChar(160)
  warehouseName          String?                     @db.VarChar(160)
  acceptedAt             DateTime?                   @db.Timestamptz(6)
  preparationStartedAt   DateTime?                   @db.Timestamptz(6)
  readyAt                DateTime?                   @db.Timestamptz(6)
  completedAt            DateTime?                   @db.Timestamptz(6)
  cancelledAt            DateTime?                   @db.Timestamptz(6)
  cancellationReason     String?                     @db.VarChar(500)
  stockRestored          Boolean?
  branch                 Branch?                     @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  warehouse              Warehouse?                  @relation(fields: [warehouseId, merchantId], references: [id, merchantId], onDelete: Restrict)
  posShift               PosShift?                   @relation(fields: [posShiftId, merchantId], references: [id, merchantId], onDelete: Restrict)
  diningSession          PosDiningSession?           @relation(fields: [posDiningSessionId, branchId, merchantId], references: [id, branchId, merchantId], onDelete: Restrict)
  createdByPosEmployee   PosEmployee?                @relation(fields: [createdByPosEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  actions                StorefrontOrderAction[]
  stockBatches           StorefrontOrderStockBatch[]
  checks                 PosOrderCheck[]
  payments               PosOrderPayment[]
  receipts               PosCheckReceipt[]
  refunds                PosOrderRefund[]
  itemReturns            PosOrderItemReturn[]
  kitchenTicket          PosKitchenTicket?

  @@unique([id, merchantId])
  @@unique([merchantId, orderReference])
  @@unique([id, branchId, merchantId])
  @@unique([id, posShiftId, merchantId])
  @@index([merchantId, status, createdAt])
  @@index([merchantId, warehouseId, status])
  @@index([merchantId, branchId, status])
  @@index([merchantId, source, createdAt])
  @@index([merchantId, posShiftId, createdAt])
  @@index([merchantId, posDiningSessionId, createdAt])
  @@map("storefront_orders")
}

model StorefrontOrderLine {
  stockHandling             String                                @default("legacy") @db.VarChar(24)
  note                      String?                               @db.VarChar(500)
  kitchenReadyAt            DateTime?                             @db.Timestamptz(6)
  stockRequirementsFrozenAt DateTime?                             @db.Timestamptz(6)
  id                        String                                @id @default(uuid()) @db.Uuid
  orderId                   String                                @db.Uuid
  merchantId                String                                @db.Uuid
  productId                 String                                @db.Uuid
  variantId                 String?                               @db.Uuid
  productName               String                                @db.VarChar(160)
  variantName               String?                               @db.VarChar(160)
  basePrice                 Decimal?                              @db.Decimal(12, 2)
  modifierTotal             Decimal?                              @db.Decimal(12, 2)
  quantity                  Int
  unitPrice                 Decimal                               @db.Decimal(12, 2)
  lineTotal                 Decimal                               @db.Decimal(12, 2)
  stockReserved             Boolean                               @default(false)
  position                  Int                                   @default(0)
  order                     StorefrontOrder                       @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Cascade)
  selections                StorefrontOrderLineSelection[]
  variantAttributes         StorefrontOrderLineVariantAttribute[]
  stockRequirements         StorefrontOrderLineStockRequirement[]
  checkAllocations          PosOrderCheckLine[]
  itemReturnLines           PosOrderItemReturnLine[]

  @@unique([id, merchantId])
  @@unique([id, orderId, merchantId])
  @@index([orderId, position])
  @@index([merchantId, variantId])
  @@map("storefront_order_lines")
}

// Checks allocate one POS order without creating duplicate sales or stock-bearing orders.
model PosOrderCheck {
  id          String              @id @default(uuid()) @db.Uuid
  orderId     String              @db.Uuid
  merchantId  String              @db.Uuid
  position    Int
  amount      Decimal             @db.Decimal(12, 2)
  splitMethod String              @db.VarChar(12)
  revision    Int                 @default(1)
  settledAt   DateTime?           @db.Timestamptz(6)
  cancelledAt DateTime?           @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  order       StorefrontOrder     @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  merchant    Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  allocations PosOrderCheckLine[]
  payments    PosOrderPayment[]
  receipt     PosCheckReceipt?
  refunds     PosOrderRefund[]

  @@unique([id, orderId, merchantId])
  @@unique([orderId, position])
  @@index([merchantId, orderId, position])
  @@map("pos_order_checks")
}

// One immutable customer receipt is issued when a POS check is fully settled.
model PosCheckReceipt {
  id                  String          @id @db.Uuid
  merchantId          String          @db.Uuid
  orderId             String          @db.Uuid
  checkId             String          @db.Uuid
  createdByEmployeeId String          @db.Uuid
  receiptNumber       String          @db.VarChar(32)
  issuedAt            DateTime        @db.Timestamptz(6)
  snapshot            Json
  merchant            Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  order               StorefrontOrder @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  check               PosOrderCheck   @relation(fields: [checkId, orderId, merchantId], references: [id, orderId, merchantId], onDelete: Restrict)
  createdBy           PosEmployee     @relation(fields: [createdByEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([merchantId, receiptNumber])
  @@unique([checkId])
  @@unique([checkId, orderId, merchantId])
  @@index([merchantId, orderId, issuedAt])
  @@map("pos_check_receipts")
}

// Immutable cashier tenders; change is recorded separately from the amount applied to the check.
model PosOrderPayment {
  cashCustody        String                @default("drawer") @db.VarChar(12)
  deliveryRemittances PosDeliveryRemittance[]
  id                 String                @id @default(uuid()) @db.Uuid
  merchantId         String                @db.Uuid
  orderId            String                @db.Uuid
  checkId            String                @db.Uuid
  shiftId            String                @db.Uuid
  operatorEmployeeId String                @db.Uuid
  requestId          String                @db.Uuid
  position           Int
  method             String                @db.VarChar(12)
  amount             Decimal               @db.Decimal(12, 2)
  receivedAmount     Decimal               @db.Decimal(12, 2)
  changeAmount       Decimal               @db.Decimal(12, 2)
  currency           String                @default("EGP") @db.Char(3)
  terminalReference  String?               @db.VarChar(80)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  merchant           Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  order              StorefrontOrder       @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  check              PosOrderCheck         @relation(fields: [checkId, orderId, merchantId], references: [id, orderId, merchantId], onDelete: Restrict)
  shift              PosShift              @relation(fields: [shiftId, merchantId], references: [id, merchantId], onDelete: Restrict)
  operator           PosEmployee           @relation(fields: [operatorEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  cashMovement       PosShiftCashMovement?
  refundTenders      PosOrderRefundTender[]

  @@unique([id, shiftId, merchantId])
  @@unique([merchantId, requestId, position])
  @@unique([id, orderId, merchantId])
  @@index([merchantId, orderId, checkId, createdAt])
  @@index([merchantId, shiftId, method, createdAt])
  @@map("pos_order_payments")
}

// Cash tender entries are written with the payment in the same transaction and record net cash kept.
model PosShiftCashMovement {
  id                 String          @id @default(uuid()) @db.Uuid
  merchantId         String          @db.Uuid
  shiftId            String          @db.Uuid
  paymentId          String          @db.Uuid
  operatorEmployeeId String          @db.Uuid
  kind               String          @default("cash_sale") @db.VarChar(20)
  amount             Decimal         @db.Decimal(12, 2)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  merchant           Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  shift              PosShift        @relation(fields: [shiftId, merchantId], references: [id, merchantId], onDelete: Restrict)
  payment            PosOrderPayment @relation(fields: [paymentId, shiftId, merchantId], references: [id, shiftId, merchantId], onDelete: Restrict)
  operator           PosEmployee     @relation(fields: [operatorEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([paymentId])
  @@unique([paymentId, shiftId, merchantId])
  @@index([merchantId, shiftId, createdAt])
  @@map("pos_shift_cash_movements")
}

// Refund records are immutable and reference the exact original tender allocation.
model PosOrderRefund {
  id                   String          @id @default(uuid()) @db.Uuid
  merchantId           String          @db.Uuid
  orderId              String          @db.Uuid
  checkId              String          @db.Uuid
  shiftId              String          @db.Uuid
  requestId            String          @db.Uuid
  createdByEmployeeId  String          @db.Uuid
  approvedByEmployeeId String?         @db.Uuid
  receiptNumber        String          @db.VarChar(40)
  reason               String          @db.VarChar(500)
  amount               Decimal         @db.Decimal(12, 2)
  currency             String          @default("EGP") @db.Char(3)
  issuedAt             DateTime        @db.Timestamptz(6)
  snapshot             Json
  merchant             Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  order                StorefrontOrder @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  check                PosOrderCheck   @relation(fields: [checkId, orderId, merchantId], references: [id, orderId, merchantId], onDelete: Restrict)
  shift                PosShift        @relation(fields: [shiftId, merchantId], references: [id, merchantId], onDelete: Restrict)
  createdBy            PosEmployee     @relation("PosRefundIssuer", fields: [createdByEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  approvedBy           PosEmployee?    @relation("PosRefundApprover", fields: [approvedByEmployeeId, merchantId], references: [id, merchantId], onDelete: Restrict)
  tenders              PosOrderRefundTender[]

  @@unique([id, shiftId, merchantId])
  @@unique([merchantId, requestId])
  @@unique([merchantId, receiptNumber])
  @@index([merchantId, orderId, checkId, issuedAt])
  @@index([merchantId, shiftId, issuedAt])
  @@map("pos_order_refunds")
}

// Physical POS item returns are immutable audit records; money and inventory stay separate.
model PosOrderItemReturn {
  id                   String                 @id @default(uuid()) @db.Uuid
  merchantId           String                 @db.Uuid
  orderId              String                 @db.Uuid
  requestId            String                 @db.Uuid
