  @@index([merchantId, orderId, issuedAt])
  @@index([merchantId, issuedAt, id])
  @@map("pos_order_item_returns")
}

model PosOrderItemReturnLine {
  id          String              @id @default(uuid()) @db.Uuid
  merchantId  String              @db.Uuid
  returnId    String              @db.Uuid
  orderId     String              @db.Uuid
  orderLineId String              @db.Uuid
  productName String              @db.VarChar(160)
  variantName String?             @db.VarChar(160)
  quantity    Int
