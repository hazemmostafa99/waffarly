{
  "name": "@waffarly/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storefront-design.css": "./src/storefront-design.css",
    "./theme.css": "./src/theme.css",
    "./dashboard-components.css": "./src/dashboard-components.css",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/react": "19.2.10",
    "@waffarly/typescript-config": "workspace:*",
    "react": "19.3.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.4",
    "react-i18next": "17.0.16",
    "tailwind-merge": "3.7.0"
  }
}
